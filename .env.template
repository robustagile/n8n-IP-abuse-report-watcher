# Copy this file to ".env" and fill in the real values.
# ".env" is gitignored and must NEVER be committed. It is this deployment's single
# source of truth — both secrets and instance-specific coordinates.
#
# Where each value ends up in the running system (NOT in the committed workflow JSON):
#   - N8N_API_URL / N8N_API_KEY -> consumed by tools/*.sh and by the n8n-mcp server
#     (.mcp.json reads them as ${N8N_API_URL} / ${N8N_API_KEY} from the environment).
#   - SLACK_WEBHOOK_URL, DATATABLE_ID, MANUAL_WEBHOOK_PATH -> substituted into the
#     workflow by tools/build-deploy.sh; the committed JSON carries
#     <<SLACK_WEBHOOK_URL>>, <<DATATABLE_ID>> and <<MANUAL_WEBHOOK_PATH>> instead.
#   - ABUSEIPDB_API_KEY -> lives ONLY as an n8n credential (encrypted store, created in
#     the n8n UI or via the API). It is listed here so the deployment can be rebuilt from
#     scratch; the exported workflow references the credential by name, never the key.

# --- Deployment coordinates ---
# Base URL of your n8n instance.
N8N_BASE_URL=https://your-n8n-host
# n8n REST API URL (usually N8N_BASE_URL + /api/v1).
N8N_API_URL=https://your-n8n-host/api/v1
# Id of the n8n Data Table holding cross-run state (not a secret).
# tools/create-datatable.sh creates the table and prints this id.
DATATABLE_ID=
# Path of the on-demand trigger webhook. Anything URL-safe works; a UUID keeps it
# unguessable, which is what stands in for authentication on this trigger.
# Generate one with: python3 -c 'import uuid; print(uuid.uuid4())'
MANUAL_WEBHOOK_PATH=00000000-0000-0000-0000-000000000000
# The resulting trigger URL. POST to it to run a check now; add ?force=1 to post to
# Slack even when there is nothing new.
MANUAL_WEBHOOK_URL=https://your-n8n-host/webhook/00000000-0000-0000-0000-000000000000

# --- Secrets ---
# n8n REST API key (Settings > API). Used by tools/*.sh and the n8n-mcp server.
N8N_API_KEY=
# AbuseIPDB API v2 key — https://www.abuseipdb.com/account/api (free tier: 1000 checks/day).
# Stored on the instance as the "AbuseIPDB API Key" httpHeaderAuth credential
# (header name "Key"), restricted to the api.abuseipdb.com domain.
ABUSEIPDB_API_KEY=
# Slack Incoming Webhook URL used to post the reports.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ
